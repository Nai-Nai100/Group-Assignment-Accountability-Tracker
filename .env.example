# Copy this file to .env (in the repo root) and replace every placeholder.
# Never commit .env. These are read by the server only; the client has no secrets.

# MongoDB Atlas connection string (also used for file storage via GridFS)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign JWT session tokens (use a long random string)
JWT_SECRET=replace-with-a-long-random-string

# Gemini API key for server-side learning objective extraction
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional: port for the API (defaults to 5000; the client dev proxy expects 5000)
PORT=5000
