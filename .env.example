# Copy this file to .env (in the repo root) and replace every placeholder.
# Never commit .env. These are read by the server only; the client has no secrets.

# MongoDB Atlas connection string (also used for file storage via GridFS)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign JWT session tokens (use a long random string)
JWT_SECRET=replace-with-a-long-random-string

# Gemini API key for server-side learning objective extraction
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional, dev/demo only: password given to the demo users created by `npm run seed`
SEED_PASSWORD=replace-with-a-demo-password

# Optional: port for the API (defaults to 5000; the client dev proxy expects 5000)
PORT=5000

# Deployment note (#14): wrong join-code guesses are limited per client IP (req.ip). Behind a hosting
# reverse proxy every client looks like the proxy's IP, so set Express's "trust proxy" for your host
# when deploying (a human decision; trusting X-Forwarded-For blindly lets clients fake their IP).
